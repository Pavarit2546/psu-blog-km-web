{
  "name": "psu-blog-km-web",
  "version": "1.0.0",
  "description": "PSU KM frontend",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3100",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@payloadcms/next": "3.94.0",
    "@payloadcms/richtext-lexical": "3.94.0",
    "@payloadcms/ui": "3.94.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "payload": "3.94.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.4.2",
    "tailwindcss": "4.3.5",
    "typescript": "5.7.3",
    "dotenv": "16.4.7"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.34.9",
  "private": true
}
